# Copy to .env. Secrets belong only in .env, never in Git or frontend variables.
# Keep the existing ADMIN_EMAIL when upgrading to preserve its workspace.
ADMIN_EMAIL=admin@example.com
AUTH_MODE=email
DJANGO_AUTH_URL=http://identity:8000
# Generate these independently: openssl rand -hex 48
DJANGO_AUTH_SERVICE_TOKEN=
DJANGO_SECRET_KEY=
RESEND_API_KEY=
# Sender must belong to your verified Resend domain.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=AgentFleets

# Your HTTPS reverse proxy forwards to the loopback-only published port.
# Replace this example origin; do not include a path or trailing slash.
PUBLIC_ORIGIN=https://fleet.example.com
# Optional: read public Codex reset announcements from X for the hourly forecast.
# Without this bearer token, the panel displays "No forecast yet".
AGENTFLEET_X_BEARER_TOKEN=
ALLOWED_ORIGINS=https://fleet.example.com
COOKIE_SECURE=true
PUBLISH_HOST=127.0.0.1

# Fail closed by default: forwarded headers are ignored unless their immediate
# peer matches this list. Set only the exact reverse-proxy peer IPs verified
# on this host; do not trust an entire private network merely for convenience.
# Example after verifying that 172.30.0.1 is this deployment's Docker gateway:
# TRUSTED_PROXIES=127.0.0.1,::1,172.30.0.1

SESSION_TTL_SECONDS=2592000
CONTROL_LEASE_TTL_SECONDS=45
PAIR_TTL_SECONDS=600
CHALLENGE_TTL_SECONDS=60
WS_TICKET_TTL_SECONDS=30
HEARTBEAT_OFFLINE_SECONDS=45
LOG_LEVEL=info

# Optional: let the AppleFleets iPhone app submit workout summaries to a
# dedicated Codex project. Generate a random token with: openssl rand -hex 32
# APPLEFLEETS_API_TOKEN=
# APPLEFLEETS_PROJECT=iwatch

# Optional shared Tibo reset-signal feed. Keep real keys in the ignored .env.
# AGENTFLEET_TIKHUB_API_KEY=
# AGENTFLEET_RADAR_DEEPSEEK_KEY=
# AGENTFLEET_RADAR_MODEL=deepseek-flash
