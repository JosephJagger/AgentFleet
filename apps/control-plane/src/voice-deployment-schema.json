"CREATE TABLE IF NOT EXISTS voice_deployment_guard (\n singleton INTEGER PRIMARY KEY CHECK(singleton=1), token TEXT NOT NULL, target TEXT NOT NULL, created_at TEXT NOT NULL\n) STRICT;\nCREATE TRIGGER IF NOT EXISTS guard_panel_voice_deployment BEFORE INSERT ON panel_voice_calls\nWHEN EXISTS(SELECT 1 FROM voice_deployment_guard WHERE singleton=1)\nBEGIN SELECT RAISE(ABORT,'VOICE_DEPLOYMENT_WAIT'); END;\nCREATE TRIGGER IF NOT EXISTS guard_session_voice_deployment BEFORE INSERT ON voice_sessions\nWHEN EXISTS(SELECT 1 FROM voice_deployment_guard WHERE singleton=1)\nBEGIN SELECT RAISE(ABORT,'VOICE_DEPLOYMENT_WAIT'); END;"
